# Active chat provider: ollama, azure, or openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Azure OpenAI
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com
API_KEY=
API_VERSION=2025-04-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=5

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://127.0.0.1:8010,http://localhost:8010
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://127.0.0.1:8010,http://localhost:8010
STRICT_DOCUMENTS_DEFAULT=True
DATABASE_CONTEXT_LIMIT=20
