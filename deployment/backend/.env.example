# Active chat provider: ollama, azure, or openai
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Azure OpenAI
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com
API_KEY=
API_VERSION=2025-04-01-preview
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=

# ChatGPT / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama runs on the Ubuntu host. From inside the container, 127.0.0.1 is the container itself.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=300
OLLAMA_CONNECT_TIMEOUT=5

DJANGO_SECRET_KEY=change-me-on-the-server
DJANGO_DEBUG=False

# Public site: https://vm24372508.manageserver.in/ and https://203.57.85.15/
DJANGO_ALLOWED_HOSTS=vm24372508.manageserver.in,203.57.85.15,127.0.0.1,localhost,backend
CORS_ALLOWED_ORIGINS=https://vm24372508.manageserver.in,https://203.57.85.15,http://203.57.85.15:3010,http://127.0.0.1:3010,http://localhost:3010
CSRF_TRUSTED_ORIGINS=https://vm24372508.manageserver.in,https://203.57.85.15,http://203.57.85.15:3010,http://127.0.0.1:3010,http://localhost:3010
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

STRICT_DOCUMENTS_DEFAULT=True
DATABASE_CONTEXT_LIMIT=20
